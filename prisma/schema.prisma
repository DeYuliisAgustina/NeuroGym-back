// =====================================================================
// NeuroGym — Modelo de datos (PostgreSQL + Prisma)
// Fuente: TFI, apartado 10.5.8 (DER y diccionario de datos).
// Tablas y columnas en snake_case (como el diccionario); modelos y
// atributos en PascalCase/camelCase (como el diagrama de clases).
// Las restricciones que Prisma no expresa (CHECK, índices parciales,
// disparadores) se agregan en la migración SQL de restricciones.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// Tipos enumerados (CREATE TYPE en PostgreSQL)
// ---------------------------------------------------------------------

enum TipoUsuario {
  SOCIO
  PERSONAL
  PROFESIONAL

  @@map("tipo_usuario")
}

enum TipoSuscripcion {
  STANDARD
  INTELLIGENCE

  @@map("tipo_suscripcion")
}

enum PoliticaCuotaPendiente {
  BLOQUEAR
  AUTORIZAR

  @@map("politica_cuota_pendiente")
}

enum TipoAcceso {
  CONSULTA
  GESTION

  @@map("tipo_acceso")
}

enum TipoPlanSocio {
  BASICO
  PREMIUM

  @@map("tipo_plan_socio")
}

enum EstadoReserva {
  RESERVADO
  CANCELADO

  @@map("estado_reserva")
}

enum FormaRegistro {
  QR
  MANUAL

  @@map("forma_registro")
}

enum EstadoEquipo {
  OPERATIVO
  FUERA_DE_SERVICIO
  SERVICE_PROGRAMADO
  DADO_DE_BAJA

  @@map("estado_equipo")
}

enum PrioridadIncidencia {
  BAJA
  MEDIA
  ALTA

  @@map("prioridad_incidencia")
}

enum EstadoIncidencia {
  REPORTADA
  EN_GESTION
  RESUELTA

  @@map("estado_incidencia")
}

enum TipoArchivo {
  FOTO
  VIDEO

  @@map("tipo_archivo")
}

enum TipoMantenimiento {
  PREVENTIVO
  CORRECTIVO

  @@map("tipo_mantenimiento")
}

enum EstadoMantenimiento {
  PROGRAMADO
  REALIZADO

  @@map("estado_mantenimiento")
}

enum EstadoPropuesta {
  PREPARADA
  PENDIENTE
  APROBADA

  @@map("estado_propuesta")
}

enum EstadoCuota {
  PENDIENTE
  PAGADA
  IMPAGA

  @@map("estado_cuota")
}

enum MedioPago {
  PAGO_UNICO
  DEBITO_AUTOMATICO
  EFECTIVO

  @@map("medio_pago")
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO

  @@map("estado_pago")
}

enum EstadoAdhesion {
  ACTIVA
  CANCELADA

  @@map("estado_adhesion")
}

enum TipoPlanMarketplace {
  BASICO
  PROFESIONAL

  @@map("tipo_plan_marketplace")
}

enum Especialidad {
  NUTRICION
  DEPORTOLOGIA

  @@map("especialidad")
}

enum ModalidadAtencion {
  ONLINE
  PRESENCIAL
  ONLINE_Y_PRESENCIAL

  @@map("modalidad_atencion")
}

enum ModalidadConsulta {
  ONLINE
  PRESENCIAL

  @@map("modalidad_consulta")
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO

  @@map("dia_semana")
}

enum TipoMetodoPago {
  OBRA_SOCIAL
  PARTICULAR
  ACUERDO_CONSULTA

  @@map("tipo_metodo_pago")
}

/// RD16: estados del turno profesional (transiciones validadas en el backend).
enum EstadoTurnoProfesional {
  SOLICITADO
  CONFIRMADO
  RECHAZADO
  CANCELADO
  REPROGRAMADO
  COMPLETADO

  @@map("estado_turno_profesional")
}

/// RD17: eventos del patrón Observer; no son estados del turno.
enum TipoEventoTurno {
  CREADO
  CANCELADO
  REPROGRAMADO

  @@map("tipo_evento_turno")
}

enum TipoNotificacion {
  TURNO_CLASE
  TURNO_PROFESIONAL
  PAGO
  VENCIMIENTO
  BENEFICIO
  INCENTIVO
  EQUIPAMIENTO

  @@map("tipo_notificacion")
}

enum CanalNotificacion {
  PLATAFORMA
  MENSAJERIA

  @@map("canal_notificacion")
}

// ---------------------------------------------------------------------
// Seguridad, usuarios y multiempresa
// ---------------------------------------------------------------------

/// Empresa cliente que contrata NeuroGym; delimita los datos de cada inquilino (RNF4).
model Gimnasio {
  id                     Int                    @id @default(autoincrement()) @map("gimnasio_id")
  razonSocial            String                 @map("razon_social") @db.VarChar(150)
  cuit                   String                 @unique @db.VarChar(13)
  toleranciaAntesMin     Int                    @default(15) @map("tolerancia_antes_min") @db.SmallInt
  toleranciaDespuesMin   Int                    @default(60) @map("tolerancia_despues_min") @db.SmallInt
  politicaCuotaPendiente PoliticaCuotaPendiente @default(BLOQUEAR) @map("politica_cuota_pendiente")
  ultimaEjecucionEtl     DateTime?              @map("ultima_ejecucion_etl") @db.Timestamp(6)
  fechaAlta              DateTime               @default(now()) @map("fecha_alta") @db.Timestamp(6)

  suscripcion SuscripcionSaas?
  sedes       Sede[]
  roles       Rol[]
  personal    PersonalAdministrativo[]
  planes      PlanSocio[]
  beneficios  Beneficio[]
  auditorias  Auditoria[]

  @@map("gimnasio")
}

/// Suscripción SaaS vigente del gimnasio (RD1, RD2, RD3).
model SuscripcionSaas {
  id               Int             @id @default(autoincrement()) @map("suscripcion_id")
  gimnasioId       Int             @unique @map("gimnasio_id")
  tipo             TipoSuscripcion
  maxSedes         Int             @map("max_sedes") @db.SmallInt
  maxSociosActivos Int             @map("max_socios_activos")
  fechaInicio      DateTime        @map("fecha_inicio") @db.Date

  gimnasio Gimnasio @relation(fields: [gimnasioId], references: [id])

  @@map("suscripcion_saas")
}

/// Establecimiento físico de un gimnasio. La deshabilitación es baja lógica (RD21).
model Sede {
  id         Int     @id @default(autoincrement()) @map("sede_id")
  gimnasioId Int     @map("gimnasio_id")
  nombre     String  @db.VarChar(100)
  direccion  String  @db.VarChar(200)
  horarios   String  @db.VarChar(200)
  habilitada Boolean @default(true)

  gimnasio    Gimnasio              @relation(fields: [gimnasioId], references: [id])
  socios      Socio[]
  turnos      TurnoClase[]
  equipos     Equipo[]
  indicadores IndicadorAsistencia[]

  @@unique([gimnasioId, nombre])
  @@index([gimnasioId])
  @@map("sede")
}

/// Credenciales y datos comunes de socios, personal y profesionales (RNF3: hash bcrypt).
model Usuario {
  id           Int         @id @default(autoincrement()) @map("usuario_id")
  email        String      @unique @db.VarChar(150)
  passwordHash String      @map("password_hash") @db.VarChar(255)
  nombre       String      @db.VarChar(100)
  apellido     String      @db.VarChar(100)
  tipo         TipoUsuario
  activo       Boolean     @default(true)
  fechaAlta    DateTime    @default(now()) @map("fecha_alta") @db.Timestamp(6)

  socio          Socio?
  personal       PersonalAdministrativo?
  profesional    Profesional?
  notificaciones Notificacion[]
  eventosTurno   EventoTurno[]
  auditorias     Auditoria[]
  enviosMensaje  EnvioMensaje[]

  @@map("usuario")
}

/// Catálogo de módulos; agrupa los permisos de cada módulo (grupo del patrón Composite).
model Modulo {
  id     Int    @id @default(autoincrement()) @map("modulo_id")
  codigo String @unique @db.VarChar(50)
  nombre String @db.VarChar(100)

  permisos Permiso[]

  @@map("modulo")
}

/// Permiso individual de consulta o gestión sobre un módulo (hoja del patrón Composite).
model Permiso {
  id       Int        @id @default(autoincrement()) @map("permiso_id")
  moduloId Int        @map("modulo_id")
  acceso   TipoAcceso

  modulo Modulo       @relation(fields: [moduloId], references: [id])
  roles  RolPermiso[]

  @@unique([moduloId, acceso])
  @@map("permiso")
}

/// Rol administrativo definido por cada gimnasio.
model Rol {
  id          Int     @id @default(autoincrement()) @map("rol_id")
  gimnasioId  Int     @map("gimnasio_id")
  nombre      String  @db.VarChar(100)
  esPrincipal Boolean @default(false) @map("es_principal")

  gimnasio Gimnasio                 @relation(fields: [gimnasioId], references: [id])
  permisos RolPermiso[]
  personal PersonalAdministrativo[]

  @@unique([gimnasioId, nombre])
  @@unique([id, gimnasioId])
  @@map("rol")
}

/// Tabla intermedia N:M entre roles y permisos.
model RolPermiso {
  rolId     Int @map("rol_id")
  permisoId Int @map("permiso_id")

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id])

  @@id([rolId, permisoId])
  @@map("rol_permiso")
}

/// Integrante del gimnasio que opera la plataforma según su rol.
model PersonalAdministrativo {
  id         Int @id @default(autoincrement()) @map("personal_id")
  usuarioId  Int @unique @map("usuario_id")
  gimnasioId Int @map("gimnasio_id")
  rolId      Int @map("rol_id")

  usuario  Usuario  @relation(fields: [usuarioId], references: [id])
  gimnasio Gimnasio @relation(fields: [gimnasioId], references: [id])
  // FK compuesta: el rol debe pertenecer al mismo gimnasio que el integrante.
  rol      Rol      @relation(fields: [rolId, gimnasioId], references: [id, gimnasioId])

  actualizacionesPrecio ActualizacionPrecio[]
  asistenciasManuales   Asistencia[]
  autorizaciones        AutorizacionExcepcional[]
  rechazos              RechazoIngreso[]
  incidencias           Incidencia[]
  mantenimientos        Mantenimiento[]
  bonificaciones        BonificacionPremium[]
  propuestas            PropuestaIncentivo[]
  decisiones            DecisionRetencion[]
  pagosEfectivo         Pago[]

  @@index([gimnasioId])
  @@map("personal_administrativo")
}

/// Plan Básico o Premium que define y cobra cada gimnasio (RD4).
model PlanSocio {
  id             Int           @id @default(autoincrement()) @map("plan_socio_id")
  gimnasioId     Int           @map("gimnasio_id")
  tipo           TipoPlanSocio
  importeMensual Decimal       @map("importe_mensual") @db.Decimal(12, 2)

  gimnasio        Gimnasio              @relation(fields: [gimnasioId], references: [id])
  socios          Socio[]
  actualizaciones ActualizacionPrecio[]

  @@unique([gimnasioId, tipo])
  @@map("plan_socio")
}

/// Historial de cambios de precio de los planes (RD12, RNF13).
model ActualizacionPrecio {
  id              Int      @id @default(autoincrement()) @map("actualizacion_id")
  planSocioId     Int      @map("plan_socio_id")
  importeAnterior Decimal  @map("importe_anterior") @db.Decimal(12, 2)
  importeNuevo    Decimal  @map("importe_nuevo") @db.Decimal(12, 2)
  vigenteDesde    DateTime @map("vigente_desde") @db.Date
  motivo          String   @db.VarChar(255)
  responsableId   Int      @map("responsable_id")
  fecha           DateTime @default(now()) @db.Timestamp(6)

  plan        PlanSocio              @relation(fields: [planSocioId], references: [id])
  responsable PersonalAdministrativo @relation(fields: [responsableId], references: [id])

  @@index([planSocioId, vigenteDesde])
  @@map("actualizacion_precio")
}

// ---------------------------------------------------------------------
// Socios
// ---------------------------------------------------------------------

/// Persona asociada a un gimnasio. El gimnasio se determina por su sede.
model Socio {
  id                  Int     @id @default(autoincrement()) @map("socio_id")
  usuarioId           Int     @unique @map("usuario_id")
  sedeId              Int     @map("sede_id")
  planSocioId         Int     @map("plan_socio_id")
  telefono            String  @db.VarChar(30)
  consentimientoDatos Boolean @map("consentimiento_datos")
  saldoPuntos         Int     @default(0) @map("saldo_puntos")

  usuario Usuario   @relation(fields: [usuarioId], references: [id])
  sede    Sede      @relation(fields: [sedeId], references: [id])
  plan    PlanSocio @relation(fields: [planSocioId], references: [id])

  codigosQr      CodigoQr[]
  reservas       Reserva[]
  rechazos       RechazoIngreso[]
  diasConstancia DiaConstancia[]
  preferencia    PreferenciaRutina?
  rutinas        Rutina[]
  incidencias    Incidencia[]
  canjes         Canje[]
  bonificaciones BonificacionPremium[]
  senales        SenalAbandono[]
  propuestas     PropuestaIncentivo[]
  estimaciones   EstimacionRiesgo[]
  cuotas         Cuota[]
  adhesiones     AdhesionDebito[]
  turnosProf     TurnoProfesional[]

  @@index([sedeId])
  @@map("socio")
}

/// Código QR personal, temporal y dinámico, sin datos personales legibles (RNF7).
model CodigoQr {
  id        Int      @id @default(autoincrement()) @map("codigo_qr_id")
  socioId   Int      @map("socio_id")
  codigo    String   @unique @db.VarChar(128)
  emitidoEn DateTime @default(now()) @map("emitido_en") @db.Timestamp(6)
  expiraEn  DateTime @map("expira_en") @db.Timestamp(6)

  socio       Socio        @relation(fields: [socioId], references: [id])
  asistencias Asistencia[]

  @@index([socioId])
  @@map("codigo_qr")
}

// ---------------------------------------------------------------------
// Turnos y asistencia
// ---------------------------------------------------------------------

/// Turno de clase o musculación ofrecido en una sede (RD18, RD23).
model TurnoClase {
  id         Int      @id @default(autoincrement()) @map("turno_clase_id")
  sedeId     Int      @map("sede_id")
  actividad  String   @db.VarChar(100)
  fecha      DateTime @db.Date
  horaInicio DateTime @map("hora_inicio") @db.Time(0)
  horaFin    DateTime @map("hora_fin") @db.Time(0)
  cupo       Int      @db.SmallInt
  habilitado Boolean  @default(true)

  sede     Sede      @relation(fields: [sedeId], references: [id])
  reservas Reserva[]

  @@index([sedeId, fecha])
  @@map("turno_clase")
}

/// Reserva de un socio para un turno; no implica asistencia.
model Reserva {
  id               Int           @id @default(autoincrement()) @map("reserva_id")
  turnoClaseId     Int           @map("turno_clase_id")
  socioId          Int           @map("socio_id")
  estado           EstadoReserva @default(RESERVADO)
  fechaReserva     DateTime      @default(now()) @map("fecha_reserva") @db.Timestamp(6)
  fechaCancelacion DateTime?     @map("fecha_cancelacion") @db.Timestamp(6)

  turno      TurnoClase  @relation(fields: [turnoClaseId], references: [id])
  socio      Socio       @relation(fields: [socioId], references: [id])
  asistencia Asistencia?

  @@unique([turnoClaseId, socioId])
  @@index([socioId])
  @@map("reserva")
}

/// Ingreso efectivo del socio, confirmado por QR o registrado manualmente (RD7).
model Asistencia {
  id            Int           @id @default(autoincrement()) @map("asistencia_id")
  reservaId     Int           @unique @map("reserva_id")
  codigoQrId    Int?          @map("codigo_qr_id")
  fechaHoraReal DateTime      @map("fecha_hora_real") @db.Timestamp(6)
  forma         FormaRegistro
  provisoria    Boolean       @default(false)
  motivo        String?       @db.VarChar(255)
  responsableId Int?          @map("responsable_id")

  reserva       Reserva                  @relation(fields: [reservaId], references: [id])
  codigoQr      CodigoQr?                @relation(fields: [codigoQrId], references: [id])
  responsable   PersonalAdministrativo?  @relation(fields: [responsableId], references: [id])
  autorizacion  AutorizacionExcepcional?
  diaConstancia DiaConstancia?

  @@index([fechaHoraReal])
  @@map("asistencia")
}

/// Autorización de ingreso con cuota impaga decidida por el personal (RD8).
model AutorizacionExcepcional {
  id            Int      @id @default(autoincrement()) @map("autorizacion_id")
  asistenciaId  Int      @unique @map("asistencia_id")
  motivo        String   @db.VarChar(255)
  responsableId Int      @map("responsable_id")
  fechaHora     DateTime @default(now()) @map("fecha_hora") @db.Timestamp(6)

  asistencia  Asistencia             @relation(fields: [asistenciaId], references: [id])
  responsable PersonalAdministrativo @relation(fields: [responsableId], references: [id])

  @@map("autorizacion_excepcional")
}

/// Intento de ingreso rechazado (QR inválido, sin reserva o bloqueo por cuota).
model RechazoIngreso {
  id            Int      @id @default(autoincrement()) @map("rechazo_id")
  socioId       Int      @map("socio_id")
  motivo        String   @db.VarChar(255)
  responsableId Int?     @map("responsable_id")
  fechaHora     DateTime @default(now()) @map("fecha_hora") @db.Timestamp(6)

  socio       Socio                   @relation(fields: [socioId], references: [id])
  responsable PersonalAdministrativo? @relation(fields: [responsableId], references: [id])

  @@index([socioId])
  @@map("rechazo_ingreso")
}

/// Día de constancia: primera asistencia confirmada de la fecha (RD9).
model DiaConstancia {
  id           Int      @id @default(autoincrement()) @map("dia_constancia_id")
  socioId      Int      @map("socio_id")
  asistenciaId Int      @unique @map("asistencia_id")
  fecha        DateTime @db.Date
  puntos       Int      @db.SmallInt

  socio      Socio      @relation(fields: [socioId], references: [id])
  asistencia Asistencia @relation(fields: [asistenciaId], references: [id])

  @@unique([socioId, fecha])
  @@map("dia_constancia")
}

// ---------------------------------------------------------------------
// Entrenamiento
// ---------------------------------------------------------------------

/// Objetivo y preferencias del socio, sin datos biométricos (RD15).
model PreferenciaRutina {
  id                 Int      @id @default(autoincrement()) @map("preferencia_id")
  socioId            Int      @unique @map("socio_id")
  objetivo           String   @db.VarChar(100)
  nivel              String   @db.VarChar(50)
  diasPorSemana      Int      @map("dias_por_semana") @db.SmallInt
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion") @db.Timestamp(6)

  socio Socio @relation(fields: [socioId], references: [id])

  @@map("preferencia_rutina")
}

/// Catálogo de ejercicios disponible para las rutinas.
model Ejercicio {
  id            Int    @id @default(autoincrement()) @map("ejercicio_id")
  nombre        String @unique @db.VarChar(100)
  grupoMuscular String @map("grupo_muscular") @db.VarChar(50)

  equipos  EjercicioEquipo[]
  enRutina EjercicioRutina[]

  @@map("ejercicio")
}

/// Rutina personalizada generada con IA; una sola vigente por socio.
model Rutina {
  id              Int      @id @default(autoincrement()) @map("rutina_id")
  socioId         Int      @map("socio_id")
  fechaGeneracion DateTime @default(now()) @map("fecha_generacion") @db.Timestamp(6)
  vigente         Boolean  @default(true)

  socio          Socio             @relation(fields: [socioId], references: [id])
  ejercicios     EjercicioRutina[]
  entrenamientos Entrenamiento[]

  @@index([socioId])
  @@map("rutina")
}

/// Ejercicio incluido en una rutina, con su carga editable por el socio.
model EjercicioRutina {
  id           Int      @id @default(autoincrement()) @map("ejercicio_rutina_id")
  rutinaId     Int      @map("rutina_id")
  ejercicioId  Int      @map("ejercicio_id")
  dia          Int      @db.SmallInt
  orden        Int      @db.SmallInt
  series       Int      @db.SmallInt
  repeticiones Int      @db.SmallInt
  pesoKg       Decimal? @map("peso_kg") @db.Decimal(6, 2)
  /// Agregado al diccionario: CU-003-002/003 muestran y editan el descanso.
  descansoSeg  Int?     @map("descanso_seg") @db.SmallInt

  rutina    Rutina    @relation(fields: [rutinaId], references: [id], onDelete: Cascade)
  ejercicio Ejercicio @relation(fields: [ejercicioId], references: [id])

  @@unique([rutinaId, dia, orden])
  @@map("ejercicio_rutina")
}

/// Registro de la realización de una rutina en una fecha (RF6).
model Entrenamiento {
  id                    Int      @id @default(autoincrement()) @map("entrenamiento_id")
  rutinaId              Int      @map("rutina_id")
  fecha                 DateTime @db.Date
  ejerciciosCompletados Int      @map("ejercicios_completados") @db.SmallInt
  ejerciciosTotales     Int      @map("ejercicios_totales") @db.SmallInt

  rutina Rutina @relation(fields: [rutinaId], references: [id])

  @@index([rutinaId])
  @@map("entrenamiento")
}

/// Tabla intermedia N:M entre ejercicios y los equipos que utilizan.
model EjercicioEquipo {
  ejercicioId Int @map("ejercicio_id")
  equipoId    Int @map("equipo_id")

  ejercicio Ejercicio @relation(fields: [ejercicioId], references: [id])
  equipo    Equipo    @relation(fields: [equipoId], references: [id], onDelete: Cascade)

  @@id([ejercicioId, equipoId])
  @@map("ejercicio_equipo")
}

// ---------------------------------------------------------------------
// Equipamiento
// ---------------------------------------------------------------------

/// Máquina o elemento de una sede. DADO_DE_BAJA = retiro definitivo (RD22).
model Equipo {
  id             Int          @id @default(autoincrement()) @map("equipo_id")
  sedeId         Int          @map("sede_id")
  nombre         String       @db.VarChar(100)
  categoria      String       @db.VarChar(50)
  estado         EstadoEquipo @default(OPERATIVO)
  fechaCompra    DateTime?    @map("fecha_compra") @db.Date
  vidaUtilAnios  Int?         @map("vida_util_anios") @db.SmallInt
  proximoService DateTime?    @map("proximo_service") @db.Date
  fechaBaja      DateTime?    @map("fecha_baja") @db.Date

  sede           Sede              @relation(fields: [sedeId], references: [id])
  ejercicios     EjercicioEquipo[]
  incidencias    Incidencia[]
  mantenimientos Mantenimiento[]

  @@index([sedeId])
  @@map("equipo")
}

/// Reporte de una falla del equipamiento (ticketera).
model Incidencia {
  id            Int                 @id @default(autoincrement()) @map("incidencia_id")
  equipoId      Int                 @map("equipo_id")
  reportanteId  Int                 @map("reportante_id")
  agrupadaEnId  Int?                @map("agrupada_en_id")
  descripcion   String              @db.Text
  prioridad     PrioridadIncidencia @default(MEDIA)
  estado        EstadoIncidencia    @default(REPORTADA)
  fecha         DateTime            @default(now()) @db.Timestamp(6)
  responsableId Int?                @map("responsable_id")

  equipo      Equipo                  @relation(fields: [equipoId], references: [id])
  reportante  Socio                   @relation(fields: [reportanteId], references: [id])
  agrupadaEn  Incidencia?             @relation("AgrupacionIncidencias", fields: [agrupadaEnId], references: [id])
  agrupadas   Incidencia[]            @relation("AgrupacionIncidencias")
  responsable PersonalAdministrativo? @relation(fields: [responsableId], references: [id])
  archivos    ArchivoIncidencia[]

  @@index([equipoId])
  @@map("incidencia")
}

/// Foto o video adjunto, guardado en el almacenamiento de objetos (RNF11).
model ArchivoIncidencia {
  id           Int         @id @default(autoincrement()) @map("archivo_id")
  incidenciaId Int         @map("incidencia_id")
  url          String      @db.VarChar(500)
  tipo         TipoArchivo
  fechaCarga   DateTime    @default(now()) @map("fecha_carga") @db.Timestamp(6)

  incidencia Incidencia @relation(fields: [incidenciaId], references: [id], onDelete: Cascade)

  @@map("archivo_incidencia")
}

/// Intervención preventiva o correctiva programada o realizada (RF22).
model Mantenimiento {
  id                   Int                 @id @default(autoincrement()) @map("mantenimiento_id")
  equipoId             Int                 @map("equipo_id")
  tipo                 TipoMantenimiento
  estado               EstadoMantenimiento @default(PROGRAMADO)
  inicioProgramado     DateTime            @map("inicio_programado") @db.Timestamp(6)
  finProgramado        DateTime            @map("fin_programado") @db.Timestamp(6)
  intervencionPrevista String?             @map("intervencion_prevista") @db.Text
  fechaRealizada       DateTime?           @map("fecha_realizada") @db.Timestamp(6)
  detalleRealizado     String?             @map("detalle_realizado") @db.Text
  responsableId        Int                 @map("responsable_id")

  equipo      Equipo                 @relation(fields: [equipoId], references: [id])
  responsable PersonalAdministrativo @relation(fields: [responsableId], references: [id])

  @@index([equipoId])
  @@map("mantenimiento")
}

// ---------------------------------------------------------------------
// Retención y analítica
// ---------------------------------------------------------------------

/// Beneficio por constancia que ofrece un gimnasio, canjeable con puntos (RF11).
model Beneficio {
  id           Int     @id @default(autoincrement()) @map("beneficio_id")
  gimnasioId   Int     @map("gimnasio_id")
  nombre       String  @db.VarChar(100)
  descripcion  String  @db.VarChar(255)
  costoPuntos  Int     @map("costo_puntos")
  vigenciaDias Int     @map("vigencia_dias") @db.SmallInt
  disponible   Boolean @default(true)

  gimnasio Gimnasio @relation(fields: [gimnasioId], references: [id])
  canjes   Canje[]

  @@index([gimnasioId])
  @@map("beneficio")
}

/// Canje de un beneficio realizado por un socio.
model Canje {
  id               Int      @id @default(autoincrement()) @map("canje_id")
  socioId          Int      @map("socio_id")
  beneficioId      Int      @map("beneficio_id")
  puntosUtilizados Int      @map("puntos_utilizados")
  fecha            DateTime @default(now()) @db.Timestamp(6)
  venceEl          DateTime @map("vence_el") @db.Date

  socio     Socio     @relation(fields: [socioId], references: [id])
  beneficio Beneficio @relation(fields: [beneficioId], references: [id])

  @@index([socioId])
  @@map("canje")
}

/// Plan Premium otorgado de forma gratuita o bonificada (RF26).
model BonificacionPremium {
  id            Int      @id @default(autoincrement()) @map("bonificacion_id")
  socioId       Int      @map("socio_id")
  desde         DateTime @db.Date
  hasta         DateTime @db.Date
  porcentaje    Decimal  @db.Decimal(5, 2)
  responsableId Int      @map("responsable_id")

  socio       Socio                  @relation(fields: [socioId], references: [id])
  responsable PersonalAdministrativo @relation(fields: [responsableId], references: [id])

  @@index([socioId, desde, hasta])
  @@map("bonificacion_premium")
}

/// Señal de posible abandono detectada por el proceso ETL.
model SenalAbandono {
  id          Int      @id @default(autoincrement()) @map("senal_id")
  socioId     Int      @map("socio_id")
  tipo        String   @db.VarChar(50)
  nivel       String   @db.VarChar(20)
  detalle     String?  @db.VarChar(255)
  detectadaEl DateTime @map("detectada_el") @db.Date

  socio      Socio                @relation(fields: [socioId], references: [id])
  propuestas PropuestaIncentivo[]

  @@index([socioId, detectadaEl])
  @@map("senal_abandono")
}

/// Incentivo de regreso preparado para un socio; requiere aprobación (RD10).
model PropuestaIncentivo {
  id                Int             @id @default(autoincrement()) @map("propuesta_id")
  socioId           Int             @map("socio_id")
  senalId           Int?            @map("senal_id")
  incentivo         String          @db.VarChar(100)
  mensaje           String          @db.Text
  estado            EstadoPropuesta @default(PREPARADA)
  responsableId     Int             @map("responsable_id")
  fechaCreacion     DateTime        @default(now()) @map("fecha_creacion") @db.Timestamp(6)
  fechaAprobacion   DateTime?       @map("fecha_aprobacion") @db.Timestamp(6)
  /// Agregado al diccionario: período y porcentaje cuando el incentivo es Premium bonificado (CU-002-010).
  premiumDias       Int?            @map("premium_dias") @db.SmallInt
  premiumPorcentaje Decimal?        @map("premium_porcentaje") @db.Decimal(5, 2)

  socio       Socio                  @relation(fields: [socioId], references: [id])
  senal       SenalAbandono?         @relation(fields: [senalId], references: [id])
  responsable PersonalAdministrativo @relation(fields: [responsableId], references: [id])

  @@index([socioId])
  @@map("propuesta_incentivo")
}

/// Estimación orientativa del riesgo de abandono (NeuroGym Intelligence).
model EstimacionRiesgo {
  id            Int      @id @default(autoincrement()) @map("estimacion_id")
  socioId       Int      @map("socio_id")
  nivel         String   @db.VarChar(20)
  fundamento    String   @db.Text
  recomendacion String   @db.Text
  fecha         DateTime @db.Date

  socio      Socio               @relation(fields: [socioId], references: [id])
  decisiones DecisionRetencion[]

  @@index([socioId, fecha])
  @@map("estimacion_riesgo")
}

/// Decisión del administrador sobre una recomendación de retención.
model DecisionRetencion {
  id            Int      @id @default(autoincrement()) @map("decision_id")
  estimacionId  Int      @map("estimacion_id")
  decision      String   @db.VarChar(100)
  motivo        String   @db.VarChar(255)
  responsableId Int      @map("responsable_id")
  fecha         DateTime @default(now()) @db.Timestamp(6)

  estimacion  EstimacionRiesgo       @relation(fields: [estimacionId], references: [id])
  responsable PersonalAdministrativo @relation(fields: [responsableId], references: [id])

  @@map("decision_retencion")
}

/// Indicadores diarios consolidados por el proceso ETL (RF35).
model IndicadorAsistencia {
  id                  Int           @id @default(autoincrement()) @map("indicador_id")
  sedeId              Int           @map("sede_id")
  fecha               DateTime      @db.Date
  tipoPlan            TipoPlanSocio @map("tipo_plan")
  asistencias         Int           @default(0)
  sociosConAsistencia Int           @default(0) @map("socios_con_asistencia")

  sede Sede @relation(fields: [sedeId], references: [id])

  @@unique([sedeId, fecha, tipoPlan])
  @@map("indicador_asistencia")
}

// ---------------------------------------------------------------------
// Cuotas y pagos
// ---------------------------------------------------------------------

/// Cuota mensual del socio, con el desglose de importes (RF31).
model Cuota {
  id               Int         @id @default(autoincrement()) @map("cuota_id")
  socioId          Int         @map("socio_id")
  periodo          String      @db.Char(7)
  cuotaBase        Decimal     @map("cuota_base") @db.Decimal(12, 2)
  adicionalPremium Decimal     @default(0) @map("adicional_premium") @db.Decimal(12, 2)
  descuento        Decimal     @default(0) @db.Decimal(12, 2)
  importeFinal     Decimal     @map("importe_final") @db.Decimal(12, 2)
  estado           EstadoCuota @default(PENDIENTE)
  fechaVencimiento DateTime    @map("fecha_vencimiento") @db.Date

  socio  Socio          @relation(fields: [socioId], references: [id])
  pagos  Pago[]
  envios EnvioMensaje[]

  @@unique([socioId, periodo])
  @@index([estado, fechaVencimiento])
  @@map("cuota")
}

/// Adhesión del socio al débito automático de Mercado Pago.
model AdhesionDebito {
  id              Int            @id @default(autoincrement()) @map("adhesion_id")
  socioId         Int            @map("socio_id")
  idPreaprobacion String         @unique @map("id_preaprobacion") @db.VarChar(100)
  estado          EstadoAdhesion @default(ACTIVA)
  fechaAlta       DateTime       @map("fecha_alta") @db.Date
  fechaBaja       DateTime?      @map("fecha_baja") @db.Date

  socio Socio  @relation(fields: [socioId], references: [id])
  pagos Pago[]

  @@index([socioId])
  @@map("adhesion_debito")
}

/// Operación de pago de una cuota. referencia_externa única evita procesar dos veces un webhook.
model Pago {
  id                Int        @id @default(autoincrement()) @map("pago_id")
  cuotaId           Int        @map("cuota_id")
  adhesionId        Int?       @map("adhesion_id")
  medio             MedioPago
  importe           Decimal    @db.Decimal(12, 2)
  estado            EstadoPago @default(PENDIENTE)
  referenciaExterna String?    @unique @map("referencia_externa") @db.VarChar(100)
  responsableId     Int?       @map("responsable_id")
  fecha             DateTime   @default(now()) @db.Timestamp(6)

  cuota       Cuota                   @relation(fields: [cuotaId], references: [id])
  adhesion    AdhesionDebito?         @relation(fields: [adhesionId], references: [id])
  responsable PersonalAdministrativo? @relation(fields: [responsableId], references: [id])
  comprobante Comprobante?

  @@index([cuotaId])
  @@map("pago")
}

/// Comprobante emitido por un pago aprobado y enviado por WhatsApp (RF32).
model Comprobante {
  id           Int       @id @default(autoincrement()) @map("comprobante_id")
  pagoId       Int       @unique @map("pago_id")
  numero       String    @unique @db.VarChar(30)
  fechaEmision DateTime  @default(now()) @map("fecha_emision") @db.Timestamp(6)
  fechaEnvio   DateTime? @map("fecha_envio") @db.Timestamp(6)

  pago   Pago           @relation(fields: [pagoId], references: [id])
  envios EnvioMensaje[]

  @@map("comprobante")
}

// ---------------------------------------------------------------------
// Marketplace de profesionales
// ---------------------------------------------------------------------

/// Plan que el profesional contrata a NeuroGym; compartido por todos los gimnasios.
model PlanMarketplace {
  id                 Int                 @id @default(autoincrement()) @map("plan_marketplace_id")
  tipo               TipoPlanMarketplace @unique
  precioMensualUsd   Decimal             @map("precio_mensual_usd") @db.Decimal(8, 2)
  porcentajeComision Decimal             @map("porcentaje_comision") @db.Decimal(5, 2)
  perfilPromocionado Boolean             @default(false) @map("perfil_promocionado")

  profesionales Profesional[]

  @@map("plan_marketplace")
}

/// Nutricionista o deportólogo independiente; no depende de ningún gimnasio.
model Profesional {
  id                  Int               @id @default(autoincrement()) @map("profesional_id")
  usuarioId           Int               @unique @map("usuario_id")
  planMarketplaceId   Int               @map("plan_marketplace_id")
  referidoPorId       Int?              @map("referido_por_id")
  especialidad        Especialidad
  modalidadAtencion   ModalidadAtencion @map("modalidad_atencion")
  valorConsulta       Decimal           @map("valor_consulta") @db.Decimal(12, 2)
  publicacionPausada  Boolean           @default(false) @map("publicacion_pausada")
  consentimientoDatos Boolean           @map("consentimiento_datos")
  codigoReferido      String?           @unique @map("codigo_referido") @db.VarChar(30)
  consultasExentas    Int               @default(0) @map("consultas_exentas") @db.SmallInt

  usuario        Usuario               @relation(fields: [usuarioId], references: [id])
  plan           PlanMarketplace       @relation(fields: [planMarketplaceId], references: [id])
  referidoPor    Profesional?          @relation("Referidos", fields: [referidoPorId], references: [id])
  referidos      Profesional[]         @relation("Referidos")
  servicios      ServicioProfesional[]
  disponibilidad Disponibilidad[]
  metodosPago    MetodoPagoConsulta[]
  turnos         TurnoProfesional[]

  @@map("profesional")
}

/// Servicio que el profesional publica en su perfil.
model ServicioProfesional {
  id            Int     @id @default(autoincrement()) @map("servicio_id")
  profesionalId Int     @map("profesional_id")
  nombre        String  @db.VarChar(100)
  descripcion   String  @db.Text
  visible       Boolean @default(true)

  profesional Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)

  @@map("servicio_profesional")
}

/// Bloque horario semanal en el que el profesional recibe consultas.
model Disponibilidad {
  id                  Int       @id @default(autoincrement()) @map("disponibilidad_id")
  profesionalId       Int       @map("profesional_id")
  diaSemana           DiaSemana @map("dia_semana")
  horaInicio          DateTime  @map("hora_inicio") @db.Time(0)
  horaFin             DateTime  @map("hora_fin") @db.Time(0)
  duracionConsultaMin Int       @default(45) @map("duracion_consulta_min") @db.SmallInt

  profesional Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)

  @@map("disponibilidad")
}

/// Método de pago de la consulta habilitado por el profesional (RF36).
model MetodoPagoConsulta {
  id            Int            @id @default(autoincrement()) @map("metodo_pago_id")
  profesionalId Int            @map("profesional_id")
  tipo          TipoMetodoPago
  obraSocial    String?        @map("obra_social") @db.VarChar(100)

  profesional Profesional        @relation(fields: [profesionalId], references: [id])
  turnos      TurnoProfesional[]

  @@unique([profesionalId, tipo, obraSocial])
  @@unique([id, profesionalId])
  @@map("metodo_pago_consulta")
}

/// Consulta solicitada por un socio Premium a un profesional (RD16).
model TurnoProfesional {
  id             Int                    @id @default(autoincrement()) @map("turno_profesional_id")
  socioId        Int                    @map("socio_id")
  profesionalId  Int                    @map("profesional_id")
  metodoPagoId   Int                    @map("metodo_pago_id")
  fecha          DateTime               @db.Date
  horaInicio     DateTime               @map("hora_inicio") @db.Time(0)
  horaFin        DateTime               @map("hora_fin") @db.Time(0)
  modalidad      ModalidadConsulta
  estado         EstadoTurnoProfesional @default(SOLICITADO)
  motivo         String?                @db.VarChar(255)
  fechaSolicitud DateTime               @default(now()) @map("fecha_solicitud") @db.Timestamp(6)

  socio       Socio              @relation(fields: [socioId], references: [id])
  profesional Profesional        @relation(fields: [profesionalId], references: [id])
  // FK compuesta: el método de pago debe pertenecer al profesional consultado.
  metodoPago  MetodoPagoConsulta @relation(fields: [metodoPagoId, profesionalId], references: [id, profesionalId])
  comision    Comision?
  eventos     EventoTurno[]

  @@index([profesionalId, fecha])
  @@index([socioId])
  @@map("turno_profesional")
}

/// Comisión calculada una única vez por consulta realizada y pagada (RD13, RF41).
model Comision {
  id                 Int      @id @default(autoincrement()) @map("comision_id")
  turnoProfesionalId Int      @unique @map("turno_profesional_id")
  importeDeclarado   Decimal  @map("importe_declarado") @db.Decimal(12, 2)
  porcentaje         Decimal  @db.Decimal(5, 2)
  importeComision    Decimal  @map("importe_comision") @db.Decimal(12, 2)
  exenta             Boolean  @default(false)
  fechaRegistro      DateTime @default(now()) @map("fecha_registro") @db.Timestamp(6)

  turno TurnoProfesional @relation(fields: [turnoProfesionalId], references: [id])

  @@map("comision")
}

// ---------------------------------------------------------------------
// Notificaciones y auditoría
// ---------------------------------------------------------------------

/// Historial de eventos del patrón Observer sobre turnos profesionales (RD17).
model EventoTurno {
  id                 Int             @id @default(autoincrement()) @map("evento_turno_id")
  turnoProfesionalId Int             @map("turno_profesional_id")
  tipo               TipoEventoTurno
  realizadoPorId     Int             @map("realizado_por_id")
  fecha              DateTime        @default(now()) @db.Timestamp(6)

  turno          TurnoProfesional @relation(fields: [turnoProfesionalId], references: [id])
  realizadoPor   Usuario          @relation(fields: [realizadoPorId], references: [id])
  notificaciones Notificacion[]

  @@index([turnoProfesionalId])
  @@map("evento_turno")
}

/// Aviso enviado a un usuario por la plataforma o por mensajería (RF33, RF42).
model Notificacion {
  id            Int               @id @default(autoincrement()) @map("notificacion_id")
  usuarioId     Int               @map("usuario_id")
  eventoTurnoId Int?              @map("evento_turno_id")
  tipo          TipoNotificacion
  canal         CanalNotificacion
  mensaje       String            @db.Text
  fecha         DateTime          @default(now()) @db.Timestamp(6)
  leida         Boolean           @default(false)

  usuario     Usuario      @relation(fields: [usuarioId], references: [id])
  eventoTurno EventoTurno? @relation(fields: [eventoTurnoId], references: [id])

  @@index([usuarioId, leida])
  @@map("notificacion")
}

/// Agregado al DER: traza de operaciones relevantes (seguridad, bajas lógicas,
/// cambios administrativos y supresión de datos). Complementa RNF13.
model Auditoria {
  id         Int      @id @default(autoincrement()) @map("auditoria_id")
  gimnasioId Int?     @map("gimnasio_id")
  usuarioId  Int?     @map("usuario_id")
  accion     String   @db.VarChar(60)
  entidad    String   @db.VarChar(60)
  entidadId  Int?     @map("entidad_id")
  detalle    Json?
  fecha      DateTime @default(now()) @db.Timestamp(6)

  gimnasio Gimnasio? @relation(fields: [gimnasioId], references: [id])
  usuario  Usuario?  @relation(fields: [usuarioId], references: [id])

  @@index([gimnasioId, fecha])
  @@map("auditoria")
}

// ---------------------------------------------------------------------
// Envíos por mensajería compatible con WhatsApp (RNF10, RF32, RF33)
// Agregado al diccionario de datos: registra cada mensaje y el estado que
// informa el proveedor. Un HTTP 200 solo significa ACEPTADO, no enviado.
// ---------------------------------------------------------------------

/// PREPARADO: mensaje armado, todavía sin respuesta del proveedor.
/// ACEPTADO: el proveedor recibió la solicitud (HTTP 2xx con id); aún no confirmó el envío.
/// ENVIADO / ENTREGADO / LEIDO: estados informados por el webhook oficial del proveedor.
/// FALLIDO: el proveedor rechazó la solicitud o informó un fallo (con detalle).
/// OMITIDO: no se envió a propósito (modo de prueba: socio no habilitado o sin destinatario).
/// SIMULADO: pruebas automáticas o sin proveedor; nunca cuenta como enviado.
enum EstadoEnvioMensaje {
  PREPARADO
  ACEPTADO
  ENVIADO
  ENTREGADO
  LEIDO
  FALLIDO
  OMITIDO
  SIMULADO

  @@map("estado_envio_mensaje")
}

enum TipoEnvioMensaje {
  COMPROBANTE
  VENCIMIENTO
  AVISO

  @@map("tipo_envio_mensaje")
}

model EnvioMensaje {
  id             Int                @id @default(autoincrement()) @map("envio_id")
  usuarioId      Int                @map("usuario_id")
  tipo           TipoEnvioMensaje
  /// Clave de idempotencia (p. ej. "comprobante:12"): un evento repetido no genera otro mensaje.
  referencia     String             @unique @db.VarChar(150)
  proveedor      String             @db.VarChar(40)
  destino        String?            @db.VarChar(30)
  texto          String             @db.Text
  /// Archivo adjunto enviado (p. ej. el PDF del comprobante); null si es solo texto.
  adjunto        String?            @db.VarChar(120)
  estado         EstadoEnvioMensaje @default(PREPARADO)
  idMensaje      String?            @unique @map("id_mensaje") @db.VarChar(200)
  detalle        String?            @db.VarChar(500)
  comprobanteId  Int?               @map("comprobante_id")
  cuotaId        Int?               @map("cuota_id")
  fechaCreacion  DateTime           @default(now()) @map("fecha_creacion") @db.Timestamp(6)
  fechaAceptado  DateTime?          @map("fecha_aceptado") @db.Timestamp(6)
  fechaEnviado   DateTime?          @map("fecha_enviado") @db.Timestamp(6)
  fechaEntregado DateTime?          @map("fecha_entregado") @db.Timestamp(6)
  fechaLeido     DateTime?          @map("fecha_leido") @db.Timestamp(6)
  fechaFallido   DateTime?          @map("fecha_fallido") @db.Timestamp(6)

  usuario     Usuario      @relation(fields: [usuarioId], references: [id])
  comprobante Comprobante? @relation(fields: [comprobanteId], references: [id])
  cuota       Cuota?       @relation(fields: [cuotaId], references: [id])

  @@index([usuarioId, fechaCreacion])
  @@index([comprobanteId])
  @@map("envio_mensaje")
}
