# ---------------------------------------------------------------
# NeuroGym-back — variables de entorno (copiar a .env y completar)
# Nunca subir el archivo .env al repositorio.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
PUBLIC_BACKEND_URL=http://localhost:3000

# PostgreSQL (base de desarrollo)
DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/neurogym_dev?schema=public"

# Seguridad: cadenas aleatorias largas (por ejemplo, 48 bytes en base64)
JWT_SECRET=
JWT_EXPIRES_IN=8h
QR_SECRET=
QR_TTL_SECONDS=120

# Reglas operativas
TZ_GIMNASIOS=America/Argentina/Buenos_Aires
PUNTOS_POR_DIA=10
CUOTA_DIA_VENCIMIENTO=10
CRON_ENABLED=false

# Mercado Pago Developers: SOLO credenciales de PRUEBA. Vacío = integración deshabilitada.
# Pago único: API de Orders (Checkout Pro). Access Token del entorno "Prueba" (empieza con APP_USR);
# se acepta solo si pertenece a una cuenta de prueba. Verificarlo con: npm run mp:verificar
# Webhooks (modo Prueba): eventos "Order (Mercado Pago)" y "Planes y suscripciones" en /api/pagos/webhook.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# WhatsApp (RNF10). Proveedor: 360dialog | meta | simulado. Vacío = se deduce de las credenciales.
WHATSAPP_PROVEEDOR=
# Fuera de producción los mensajes van SOLO a este número (formato internacional, 549...).
WHATSAPP_TEST_RECIPIENT=
# Socios (correos, separados por coma) cuyos eventos generan envíos reales en desarrollo; el resto queda OMITIDO.
WHATSAPP_SOCIOS_PRUEBA=
# Sandbox oficial de 360dialog (gratuito, sin tarjeta): clave obtenida enviando START por WhatsApp.
DIALOG360_API_KEY=
# Token secreto de la ruta del webhook de estados de 360dialog (cadena aleatoria larga).
WHATSAPP_WEBHOOK_TOKEN=
# URL HTTPS pública del backend (túnel en desarrollo): WhatsApp descarga de ahí el PDF del comprobante
# mediante un enlace firmado de 15 minutos. Vacía = el comprobante no se envía (FALLIDO, nunca solo texto).
WHATSAPP_URL_PUBLICA=
# WhatsApp Business Cloud API de Meta (número de prueba).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
# Webhook de Meta: clave secreta de la app (firma X-Hub-Signature-256) y token de verificación.
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# API de IA para rutinas. IA_PROVEEDOR = gemini | claude | simulado (vacío: el que tenga clave).
# Gemini: clave gratuita de Google AI Studio (aistudio.google.com/apikey), sin tarjeta.
# Sin ninguna clave = generación de rutinas simulada.
IA_PROVEEDOR=
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.5-flash
GEMINI_MODELOS_RESPALDO=gemini-flash-lite-latest
ANTHROPIC_API_KEY=
IA_MODELO=claude-opus-5-5

# Almacenamiento de objetos (desarrollo: carpeta local)
UPLOADS_DIR=./uploads
UPLOAD_MAX_BYTES=26214400

# Contraseña de las cuentas ficticias del seed (solo desarrollo)
SEED_PASSWORD=
# Correo de la cuenta compradora de prueba (pagador de suscripciones en prueba)
MP_TEST_PAYER_EMAIL=
# URL HTTPS pública del frontend (túnel de desarrollo) para back_urls de Mercado Pago
MP_PUBLIC_FRONTEND_URL=
