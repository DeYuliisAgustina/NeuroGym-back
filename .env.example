# ---------------------------------------------------------------
# NeuroGym-back — variables de entorno (copiar a .env y completar)
# Nunca subir el archivo .env al repositorio.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
PUBLIC_BACKEND_URL=http://localhost:3000

# PostgreSQL (base de desarrollo)
DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/neurogym_dev?schema=public"

# Seguridad: cadenas aleatorias largas (por ejemplo, 48 bytes en base64)
JWT_SECRET=
JWT_EXPIRES_IN=8h
QR_SECRET=
QR_TTL_SECONDS=120

# Reglas operativas
TZ_GIMNASIOS=America/Argentina/Buenos_Aires
PUNTOS_POR_DIA=10
CUOTA_DIA_VENCIMIENTO=10
CRON_ENABLED=false

# Mercado Pago (credenciales de PRUEBA). Vacío = simulador local, sin cobros.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# WhatsApp Business Cloud API. Vacío = mensajería simulada (no envía mensajes).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# API de IA (Claude). Vacío = generación de rutinas simulada.
ANTHROPIC_API_KEY=
IA_MODELO=claude-opus-5-5

# Almacenamiento de objetos (desarrollo: carpeta local)
UPLOADS_DIR=./uploads
UPLOAD_MAX_BYTES=26214400

# Contraseña de las cuentas ficticias del seed (solo desarrollo)
SEED_PASSWORD=
